# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=test_app_secret_jamais_utilise_en_reel

# App\Dms (service transverse) - cle de chiffrement en flux du contenu binaire, echec ferme strict
# (RG-DMS-25/28, App\Dms\Crypto\DocumentStreamCipher) : valeur de convenance dediee aux tests.
DMS_ENCRYPTION_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
DMS_MAX_UPLOAD_BYTES=104857600

# Lexik JWT -- LE BANC A SES PROPRES CLES, ET NE TOUCHE PAS A CELLES DE LA PREPRODUCTION.
#
# `config/jwt/private.pem` est chiffree par une passphrase que seul `.env.local` connait. Un test qui
# l'emprunte echoue en JWTEncodeFailureException sur CHAQUE requete authentifiee : 29 erreurs sur 39
# tests du module Offre, toutes identiques, aucune liee au code qu'on teste.
#
# La tentation etait de laisser `test-stack.sh` regenerer le couple -- il le fait quand le fichier
# manque. Ca aurait REECRIT les cles de la preproduction et invalide toutes les sessions ouvertes,
# dont celle depuis laquelle on verifie les ecrans.
#
# Couple dedie, sans passphrase, ignore par git (`/config/jwt/*.pem`). Meme convention que
# `DMS_ENCRYPTION_KEY` ci-dessus : une valeur de convenance qui ne protege rien de reel.
JWT_SECRET_KEY='%kernel.project_dir%/config/jwt/test-private.pem'
JWT_PUBLIC_KEY='%kernel.project_dir%/config/jwt/test-public.pem'
JWT_PASSPHRASE=''

# ── CLES DE CONVENANCE POUR LES TESTS ───────────────────────────────────────────────────────────
#
# ⚠ CES VALEURS NE PROTEGENT RIEN DE REEL, et c'est assume -- meme raison que `DMS_ENCRYPTION_KEY`
# plus haut. Elles existent pour que le conteneur de test demarre : le code refuse une cle absente
# ou mal formee, ce qui est le bon comportement.
#
# Les vraies vivent dans `infra/.env.preprod`, hors du depot, generees par le deploiement.
# Second facteur d'authentification.
MFA_ENCRYPTION_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Coordonnees bancaires (mandats SEPA).
SEPA_IBAN_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Cles d'API tierces confiees par le client.
OCR_API_KEY_ENCRYPTION_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Jetons des comptes de reseaux sociaux.
SOCIAL_TOKEN_ENCRYPTION_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Signature du scellement Vente.
NF525_SEAL_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Signature du scellement Compta.
NF525_COMPTA_SEAL_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=
# Signature du scellement Facturation.
NF525_FACTURATION_SEAL_KEY=dGVzdHRlc3R0ZXN0dGVzdHRlc3R0ZXN0dGVzdDEyMz0=

# Le parcours SEPA se deroule dans les tests : ils verifient la generation du pain.008 et le
# chainage des statuts, pas le raccordement bancaire. Le REFUS a pour temoin son propre test
# unitaire, qui instancie l'adaptateur avec le drapeau a faux.
SEPA_TRANSMISSION_SIMULEE=1

PAIEMENT_EN_LIGNE_BOUCHON_AUTORISE=1
TPE_SIMULE_AUTORISE=1
SIGNATURE_SEAL_KEY=c2lnbmF0dXJldGVzdHNpZ25hdHVyZXRlc3RzaWduMTIzND0=
