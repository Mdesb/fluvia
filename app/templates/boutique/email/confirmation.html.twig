<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de commande {{ numeroCommande }}</title>
</head>
<body style="font-family: Arial, sans-serif; color: #222222; margin: 0; padding: 0; background: #f4f4f4;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f4f4f4; padding: 24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background: #ffffff; border-radius: 8px; overflow: hidden;">
                    <tr>
                        <td style="background: #1a2b4c; color: #ffffff; padding: 20px 24px;">
                            <h1 style="margin: 0; font-size: 18px;">{{ etablissementNom }}</h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 24px;">
                            <p>Bonjour,</p>
                            <p>Votre commande <strong>n°{{ numeroCommande }}</strong> d'un montant de <strong>{{ total }} &euro;</strong> est confirmée.</p>
                            {% if nbBillets > 0 %}
                                <p>
                                    {{ nbBillets }} billet{{ nbBillets > 1 ? 's' : '' }}
                                    {{ nbBillets > 1 ? 'sont disponibles' : 'est disponible' }} immédiatement :
                                    vous les trouverez en pièce jointe (PDF, avec QR) et dans votre espace client.
                                </p>
                            {% endif %}
                            {% if factureJointe %}
                                <p>La facture correspondante est également jointe à cet e-mail.</p>
                            {% endif %}
                            <p style="margin-top: 24px;">Merci de votre confiance.</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 24px; background: #f0f0f0; font-size: 11px; color: #777777;">
                            Cet e-mail vous a été envoyé automatiquement suite à votre achat en ligne.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
