# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://app:app@db:3306/app?serverVersion=11.4.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=b01a2f5d8427f539574c70d1b6802f577893cfd9e50c38d8c64ee5c4930b4f3d
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/securite (L7) ###
# Clé de chiffrement (libsodium, sodium_crypto_secretbox) du secret MFA au repos — 32 octets
# base64. Valeur de dev/test ci-dessous ; à générer réellement en production
# (ex. `php -r "echo base64_encode(random_bytes(32));"`).
MFA_ENCRYPTION_KEY=zqK5X0sQe9Y2f1Vb8dC4nH7jM3pL6rT0wA5yU9iO2sE=
# Lien front construit pour les e-mails d'invitation/réinitialisation (pas encore de front réel).
FRONT_BASE_URL=http://localhost:5173
###< app/securite (L7) ###

###> app/sepa (module partagé App\Sepa) ###
# Clé HMAC applicative de tokenisation IBAN (⚠ Risque n°3 du plan-sport, repris plan-sepa §4 : non un
# vrai coffre-fort de paiement PCI-DSS). Valeur de dev/test ci-dessous ; à remplacer par un vrai PSP/HSM
# en production. Anciennement SPORT_IBAN_HMAC_KEY (module désormais partagé, plus seulement Sport).
SEPA_IBAN_HMAC_KEY=change-me-sepa-iban-hmac-dev-key
# Clé de chiffrement réversible de l'IBAN (coffre IBAN, `App\Sepa\Service\ChiffreurIban`, libsodium
# crypto_secretbox) — 32 octets encodés en base64. Permet à la remise pain.008 de porter le véritable
# IBAN. Valeur de dev/test ci-dessous (générée via `php -r "echo base64_encode(random_bytes(32));"`) ;
# **en production, cette clé doit provenir d'un secret/vault** (Symfony secrets, Vault, KMS…) et ne
# jamais être committée en clair — au même titre que MFA_ENCRYPTION_KEY.
SEPA_IBAN_KEY=iZn26szUHEcrLWynmUSO3wRo63AJRbhJxhVLI27UOaU=
###< app/sepa (module partagé App\Sepa) ###

###> app/vente (module App\Vente — code de support signé, CA-12) ###
# Clé HMAC applicative de signature du code de support unique (billet/carte/abonnement/billet
# boutique — `App\Vente\Service\GenerateurCodeSupport`, consommée en vérification par le contrôle
# d'accès `App\Acces\Service\ValidationPassageHandler`). Non un vrai HSM (⚠ même limite que
# `SEPA_IBAN_HMAC_KEY`). Valeur de dev/test ci-dessous ; **en production, cette clé doit provenir
# d'un secret/vault** (Symfony secrets, Vault, KMS…) et ne jamais être committée en clair — au même
# titre que MFA_ENCRYPTION_KEY/SEPA_IBAN_KEY.
SUPPORT_HMAC_KEY=change-me-support-hmac-dev-key
###< app/vente (module App\Vente — code de support signé, CA-12) ###

###> app/acces-terminal (module App\Acces — réconciliation crédit négatif borné, CA-8) ###
# Plancher du crédit négatif borné en cas de réconciliation gracieuse hors-ligne (double-consommation,
# plan-acces-terminal.md §4.2). N'a d'effet que si le flag `autoriserCreditNegatifSiHorsLigne` est actif
# (désactivé par défaut, non exposé par ce lot — cf. Risque R-6). Entier <= 0.
ACCES_PLANCHER_CREDIT_NEGATIF=-1
###< app/acces-terminal (module App\Acces — réconciliation crédit négatif borné, CA-8) ###

###> app/ocr (service transverse App\Ocr - cle API fournisseur chiffree, RG-OCR-06) ###
# Cle de chiffrement reversible de la cle API du fournisseur OCR
# (`App\Ocr\Service\ChiffreurApiKeyOcr`, libsodium `crypto_secretbox`, meme patron que
# MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY). Une cle dediee par usage : compromettre l'OCR ne doit pas
# donner le secret MFA. Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un
# secret/vault** (Symfony secrets, Vault, KMS...) et ne jamais etre committee en clair.
#
# Sans cette variable, `ChiffreurApiKeyOcr` se rabattait sur une constante ecrite dans le depot : la
# cle API du fournisseur etait alors chiffree avec un secret public, donc dechiffrable par quiconque
# lit le code. Elle existe pour que ce repli disparaisse.
OCR_API_KEY_ENCRYPTION_KEY=q46Gvj92ESJ6aTAyQm61DZvdyvVO6ly66E6dQsdTC2U=
###< app/ocr (service transverse App\Ocr - cle API fournisseur chiffree, RG-OCR-06) ###

###> app/vente (module App\Vente - scellement NF525) ###
# Cle HMAC de scellement de la chaine d'operations NF525
# (`App\Vente\Nf525\HashChainSignataire`). NF525 impose l'inalterabilite des enregistrements : si
# cette cle est connue, n'importe qui peut modifier une operation puis recalculer une signature
# valide, et la garantie ne tient plus. C'est une surface de **conformite legale**, pas seulement de
# securite.
#
# Elle etait auparavant une valeur par defaut ecrite dans le code (`nf525-placeholder-key`), donc
# publique. Le bouchon etait assume et documente ; ce qui manquait, c'est un mecanisme obligeant a le
# retirer. La variable n'a plus de valeur par defaut : sans elle, le conteneur refuse de demarrer.
#
# Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un secret/vault** et ne
# jamais etre committee en clair - au meme titre que MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY.
# Changer cette cle invalide toutes les signatures deja produites : a faire avant qu'il n'existe des
# ecritures fiscales reelles, pas apres.
NF525_SEAL_KEY=SDBMsrbFsUiWRUyvgpSa4ud7j4T1WNHhc4d7RyOhhRI=
###< app/vente (module App\Vente - scellement NF525) ###

###> app/compta (module App\Compta - scellement NF525) ###
# Cle HMAC dediee au scellement de la chaine d ecritures comptables NF525
# (App\Compta\Nf525\ScellementEcritureHandler). Distincte de NF525_SEAL_KEY (Vente).
# Injectee sans valeur par defaut : son absence empeche le demarrage (echec ferme).
NF525_COMPTA_SEAL_KEY=NeCqbDwCzm50a+8GBQ8fTm6E27PfJbA39RVTwgu5s4o=
###< app/compta (module App\Compta - scellement NF525) ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
