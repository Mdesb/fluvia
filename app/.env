# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> fluvia ###
# D104 : une boutique par sous-domaine. `piscine-ville.fluvia-app.com` designe la vitrine dont le
# slug est `piscine-ville`. La preprod ne porte pas ce domaine : c'est pour ca que c'est une
# configuration et pas un litteral -- sinon la resolution par hote ne serait testable qu'en
# production, donc jamais testee.
PLATFORM_BASE_DOMAIN=fluvia-app.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://app:app@db:3306/app?serverVersion=11.4.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/securite (L7) ###
# Clé de chiffrement (libsodium, sodium_crypto_secretbox) du secret MFA au repos — 32 octets
# base64. Valeur de dev/test ci-dessous ; à générer réellement en production
# (ex. `php -r "echo base64_encode(random_bytes(32));"`).
MFA_ENCRYPTION_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
# Lien front construit pour les e-mails d'invitation/réinitialisation (pas encore de front réel).
FRONT_BASE_URL=http://localhost:5173
###< app/securite (L7) ###

###> app/subscription (site vitrine, ED-5) ###
# Le site qui VEND la plateforme — hôte distinct du back-office (D103). Le lien de confirmation
# d'essai est construit dessus, et surtout PAS sur FRONT_BASE_URL : celui-ci désigne l'application,
# où le prospect n'a encore aucun compte. Le lien y afficherait une page de connexion, sur un
# parcours où le visiteur n'a jamais choisi de mot de passe.
# Valeur réelle de la préprod dans `.env.local` (hors dépôt) : https://vitrine.hector-conseil.com
VITRINE_BASE_URL=http://localhost:5174

# ⚠ LE SITE PUBLIC EST-IL OUVERT AUX MOTEURS ? Defaut : NON, et ce defaut est le bon — un site
# marchand sans mentions legales ni CGV ne doit pas etre indexe, et une page indexee ne se retire pas
# d'un clic. Passer a `1` ouvre d'un seul geste : la balise `robots` de chaque page, `robots.txt` et
# `llms.txt` lisent tous cette variable.
WEBSITE_INDEXABLE=0
###< app/subscription (site vitrine, ED-5) ###

###> app/sepa (module partagé App\Sepa) ###
# Clé HMAC applicative de tokenisation IBAN (⚠ Risque n°3 du plan-sport, repris plan-sepa §4 : non un
# vrai coffre-fort de paiement PCI-DSS). Valeur de dev/test ci-dessous ; à remplacer par un vrai PSP/HSM
# en production. Anciennement SPORT_IBAN_HMAC_KEY (module désormais partagé, plus seulement Sport).
SEPA_IBAN_HMAC_KEY=change-me-sepa-iban-hmac-dev-key
# Clé de chiffrement réversible de l'IBAN (coffre IBAN, `App\Sepa\Service\ChiffreurIban`, libsodium
# crypto_secretbox) — 32 octets encodés en base64. Permet à la remise pain.008 de porter le véritable
# IBAN. Valeur de dev/test ci-dessous (générée via `php -r "echo base64_encode(random_bytes(32));"`) ;
# **en production, cette clé doit provenir d'un secret/vault** (Symfony secrets, Vault, KMS…) et ne
# jamais être committée en clair — au même titre que MFA_ENCRYPTION_KEY.
SEPA_IBAN_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/sepa (module partagé App\Sepa) ###

###> app/vente (module App\Vente — code de support signé, CA-12) ###
# Clé HMAC applicative de signature du code de support unique (billet/carte/abonnement/billet
# boutique — `App\Vente\Service\GenerateurCodeSupport`, consommée en vérification par le contrôle
# d'accès `App\Acces\Service\ValidationPassageHandler`). Non un vrai HSM (⚠ même limite que
# `SEPA_IBAN_HMAC_KEY`). Valeur de dev/test ci-dessous ; **en production, cette clé doit provenir
# d'un secret/vault** (Symfony secrets, Vault, KMS…) et ne jamais être committée en clair — au même
# titre que MFA_ENCRYPTION_KEY/SEPA_IBAN_KEY.
SUPPORT_HMAC_KEY=change-me-support-hmac-dev-key
###< app/vente (module App\Vente — code de support signé, CA-12) ###

###> app/acces-terminal (module App\Acces — réconciliation crédit négatif borné, CA-8) ###
# Plancher du crédit négatif borné en cas de réconciliation gracieuse hors-ligne (double-consommation,
# plan-acces-terminal.md §4.2). N'a d'effet que si le flag `autoriserCreditNegatifSiHorsLigne` est actif
# (désactivé par défaut, non exposé par ce lot — cf. Risque R-6). Entier <= 0.
ACCES_PLANCHER_CREDIT_NEGATIF=-1
###< app/acces-terminal (module App\Acces — réconciliation crédit négatif borné, CA-8) ###

###> app/ocr (service transverse App\Ocr - cle API fournisseur chiffree, RG-OCR-06) ###
# Cle de chiffrement reversible de la cle API du fournisseur OCR
# (`App\Ocr\Service\ChiffreurApiKeyOcr`, libsodium `crypto_secretbox`, meme patron que
# MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY). Une cle dediee par usage : compromettre l'OCR ne doit pas
# donner le secret MFA. Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un
# secret/vault** (Symfony secrets, Vault, KMS...) et ne jamais etre committee en clair.
#
# Sans cette variable, `ChiffreurApiKeyOcr` se rabattait sur une constante ecrite dans le depot : la
# cle API du fournisseur etait alors chiffree avec un secret public, donc dechiffrable par quiconque
# lit le code. Elle existe pour que ce repli disparaisse.
OCR_API_KEY_ENCRYPTION_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/ocr (service transverse App\Ocr - cle API fournisseur chiffree, RG-OCR-06) ###

###> app/vente (module App\Vente - scellement NF525) ###
# Cle HMAC de scellement de la chaine d'operations NF525
# (`App\Vente\Nf525\HashChainSignataire`). NF525 impose l'inalterabilite des enregistrements : si
# cette cle est connue, n'importe qui peut modifier une operation puis recalculer une signature
# valide, et la garantie ne tient plus. C'est une surface de **conformite legale**, pas seulement de
# securite.
#
# Elle etait auparavant une valeur par defaut ecrite dans le code (`nf525-placeholder-key`), donc
# publique. Le bouchon etait assume et documente ; ce qui manquait, c'est un mecanisme obligeant a le
# retirer. La variable n'a plus de valeur par defaut : sans elle, le conteneur refuse de demarrer.
#
# Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un secret/vault** et ne
# jamais etre committee en clair - au meme titre que MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY.
# Changer cette cle invalide toutes les signatures deja produites : a faire avant qu'il n'existe des
# ecritures fiscales reelles, pas apres.
NF525_SEAL_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/vente (module App\Vente - scellement NF525) ###

###> app/compta (module App\Compta - scellement NF525) ###
# Cle HMAC dediee au scellement de la chaine d ecritures comptables NF525
# (App\Compta\Nf525\ScellementEcritureHandler). Distincte de NF525_SEAL_KEY (Vente).
# Injectee sans valeur par defaut : son absence empeche le demarrage (echec ferme).
NF525_COMPTA_SEAL_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/compta (module App\Compta - scellement NF525) ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/facturation (module App\Facturation - scellement NF525) ###
# Cle HMAC dediee au scellement de la chaine de factures NF525
# (`App\Facturation\Nf525\ScellementFactureHandler`). Troisieme et derniere chaine du projet, apres
# Vente et Compta - et la plus sensible des trois : une facture scellee est la piece que
# l'administration fiscale examine.
#
# Cle DISTINCTE des deux autres : une cle par usage, pour que compromettre une chaine n'en donne
# aucune autre. Aucune valeur par defaut cote code - son absence empeche le demarrage.
#
# Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un secret/vault** et ne
# jamais etre committee en clair. Changer cette cle invalide les signatures deja produites : a faire
# avant qu'il n'existe des factures reelles, pas apres.
NF525_FACTURATION_SEAL_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/facturation (module App\Facturation - scellement NF525) ###

###> app/dms (service transverse App\Dms - chiffrement au repos en flux, RG-DMS-25/28) ###
# Cle de chiffrement du contenu binaire des documents (`App\Dms\Crypto\DocumentStreamCipher`,
# libsodium `crypto_secretstream_xchacha20poly1305`, traitement PAR BLOCS de 1 MiB - jamais le fichier
# entier en memoire, RG-DMS-28). 32 octets encodes en base64. Cle DEDIEE (une cle par usage, comme
# MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY / OCR_API_KEY_ENCRYPTION_KEY) : compromettre la GED ne doit donner
# acces a aucun autre secret applicatif.
#
# ECHEC FERME STRICT (RG-DMS-25, different de ChiffreurIban) : contrairement aux autres chiffreurs de
# ce depot, `DocumentStreamCipher` ne derive AUCUNE cle de secours si la valeur est absente/mal
# formee - le conteneur refuse de demarrer (CA-12). La mesure protege d'un disque ou d'une sauvegarde
# exfiltres, PAS d'une application compromise qui detiendrait la cle.
#
# Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un secret/vault** (Vault,
# KMS...) et ne jamais etre committee en clair, jamais regeneree apres le premier document stocke (une
# rotation necessiterait un rechiffrement complet du contenu existant, hors perimetre v1).
DMS_ENCRYPTION_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
# Plafond de taille d'upload par fichier, en octets (proposition raisonnee non normative, plan-dms.md
# §0.3) - 100 Mo. A aligner avec `client_max_body_size` (nginx) et `upload_max_filesize`/
# `post_max_size` (php.ini), tous >= cette valeur + marge multipart (~10%).
DMS_MAX_UPLOAD_BYTES=104857600
###< app/dms (service transverse App\Dms - chiffrement au repos en flux, RG-DMS-25/28) ###

###> app/social (App\Social - coffre a jetons des reseaux sociaux, SOC-1) ###
# Cle de chiffrement au repos des jetons d'acces des reseaux sociaux. 32 octets encodes en base64.
# Cle DEDIEE (une cle par usage, comme MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY / DMS_ENCRYPTION_KEY) :
# compromettre la publication sociale ne doit donner acces a aucun autre secret applicatif.
#
# ECHEC FERME, sans repli code en dur : ce qui est stocke ici permet de publier AU NOM d'un tiers.
# Une valeur par defaut silencieuse ferait qu'un deploiement mal configure chiffrerait tous les jetons
# de tous les etablissements avec une cle connue de quiconque a lu le depot.
#
# Valeur de dev/test ci-dessous ; **en production, cette cle doit provenir d'un secret/vault** et ne
# jamais etre committee en clair. Une rotation impose de rechiffrer les jetons existants, ou de les
# invalider et de refaire passer chaque etablissement par l'autorisation du reseau.
SOCIAL_TOKEN_ENCRYPTION_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/social ###

###> app/integrations (App\Integrations - coffre des URL de webhook, connecteurs Slack/Teams/Discord) ###
# Cle de chiffrement au repos des URL de webhook des connecteurs. 32 octets encodes en base64.
# Cle DEDIEE (une cle par usage, comme MFA_ENCRYPTION_KEY / SEPA_IBAN_KEY / SOCIAL_TOKEN_ENCRYPTION_KEY) :
# une URL de webhook Slack est un droit de publier dans un canal, sans autre authentification.
#
# ⚠ ELLE ETAIT EXIGEE ET DECLAREE NULLE PART. `WebhookUrlCipher` la reclame par `#[Autowire(env:)]` ;
# sans cette ligne, le NOYAU NE SE CONSTRUIT PAS la ou l'environnement ne la porte pas. La
# preproduction tournait parce que la variable y avait ete posee a la main, mais le garde-fou n°33
# etait mort depuis — « la table de routes est inexploitable » — et un deploiement neuf aurait
# echoue au demarrage sans que rien ne dise laquelle des neuf cles manquait.
#
# ECHEC FERME, sans repli code en dur : une valeur de dev ici chiffrerait les URL de tous les
# etablissements avec une cle connue de quiconque a lu le depot.
INTEGRATIONS_WEBHOOK_KEY=A_GENERER_PAR_LE_DEPLOIEMENT_VOIR_infra_env.preprod.example
###< app/integrations ###

###> app/organisation (designation de l'etablissement editeur - Q-1) ###
# UUID de l'etablissement qui exploite la plateforme : l'editeur lui-meme.
#
# Le tunnel de souscription commence par un prospect ANONYME qui compose son panier avant d'avoir la
# moindre fiche client. Les evenements de domaine exigent un etablissement porteur, et a ce stade il
# n'y a rien a deduire. La designation doit donc etre explicite, et elle appartient au deploiement :
# rien dans le modele ne distingue l'editeur d'un client, et c'est tres bien ainsi.
#
# VOLONTAIREMENT VIDE ICI. `EditorTenantResolver` echoue a l'USAGE, pas au demarrage du conteneur —
# une variable absente ne doit pas empecher huit sessions de tester des modules sans rapport. Renseigne
# la valeur dans `.env.local` (ignore par git) ou dans l'environnement de deploiement.
#
# AUCUN REPLI n'est prevu : pas de « premier etablissement trouve », pas de valeur par defaut. Un repli
# silencieux ferait porter les souscriptions de tous les clients par un etablissement pris au hasard,
# et personne ne le verrait avant la facturation.
EDITOR_TENANT_ID=
###< app/organisation ###

###> app/sepa ###
# TRANSMISSION SEPA SIMULEE — le defaut est le REFUS.
#
# Aucun collecteur bancaire (EBICS/SFTP) n'est raccorde : `CollecteurSepaStubAdapter` refuse donc
# de transmettre, et la remise reste en statut `Generee` avec son pain.008 conserve.
#
# ⚠ POURQUOI UN DRAPEAU ET NON `APP_ENV`. La preprod tourne sous `APP_ENV=prod`
# (`infra/compose.preprod.yaml`) : une porte sur l'environnement ferait refuser le bouchon
# precisement la ou on veut derouler le parcours. Et le defaut choisi est le refus, pour qu'une
# installation qui oublie la variable echoue FERMEE — la forme inverse echouerait ouverte dans tout
# environnement autrement nomme.
SEPA_TRANSMISSION_SIMULEE=0
###< app/sepa ###

###> app/subscription ###
# LIEN DE CONFIRMATION D'ESSAI FRAPPE A LA MAIN — le defaut est le REFUS.
#
# Tant qu'E-8 tient (aucun expediteur reel), le lien de confirmation d'un essai n'existe NULLE PART
# apres l'envoi : la base ne garde que son `sha256`, et `LogClientNotifier` ne journalise ni le
# contenu ni les variables. Le tunnel d'inscription ne peut donc etre deroule jusqu'au bout par
# personne. `app:trial:confirmation-link` rend ce lien pour la recette.
#
# ⚠ CETTE VARIABLE OUVRE UN CONTOURNEMENT, ET SON NOM LE DIT. L'essai gratuit ne demande aucun
# paiement : le clic sur le lien est ce qui remplace le mandat SEPA. La commande frappe ce lien sans
# passer par l'adresse du prospect. Elle ne doit JAMAIS etre ouverte en production.
#
# ⚠ POURQUOI UN DRAPEAU ET NON `APP_ENV` — meme raison que `SEPA_TRANSMISSION_SIMULEE` ci-dessus :
# la preprod tourne sous `APP_ENV=prod`, et une porte sur l'environnement fermerait l'outil
# precisement la ou on veut eprouver le parcours. Le defaut est le refus, pour qu'un oubli echoue
# FERME.
#
# ⚠ CE VERROU N'EST PAS UNE SECURITE, C'EST UNE INTENTION : qui peut poser la variable peut lancer
# la commande. La vraie fermeture, c'est la levee d'E-8 — apres quoi cette commande se retire.
TRIAL_CONFIRMATION_BYPASS=0
###< app/subscription ###
