# Secrets de la PRODUCTION (conteneur LXD chez IT Cotation).
#
# Ne remplissez rien à la main : infra/deploy-prod.sh copie ce fichier en infra/.env.prod (droits 600)
# et génère chaque valeur vide au premier déploiement. Elles ne sont jamais régénérées ensuite :
# changer une clé rend indéchiffrable ce qui a été chiffré avec elle.
#
# ⚠ Ne JAMAIS recopier une valeur de .env.preprod ici : une clé par installation.
# Les bouchons de paiement (PAIEMENT_EN_LIGNE_BOUCHON_AUTORISE, TPE_SIMULE_AUTORISE) n'ont PAS de
# ligne : ils sont fermés en dur dans infra/compose.prod.yaml.

APP_SECRET=

DB_NAME=fluvia
DB_USER=fluvia
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_PASSPHRASE=

DMS_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
SEPA_IBAN_KEY=
OCR_API_KEY_ENCRYPTION_KEY=
SOCIAL_TOKEN_ENCRYPTION_KEY=
INTEGRATIONS_WEBHOOK_KEY=
SUPPORT_HMAC_KEY=
SEPA_IBAN_HMAC_KEY=
PUBLIC_API_SUPPORT_REF_KEY=
PARTNER_WEBHOOK_KEY=
NF525_SEAL_KEY=
NF525_COMPTA_SEAL_KEY=
NF525_FACTURATION_SEAL_KEY=
SIGNATURE_SEAL_KEY=

# Livraison des webhooks partenaires : fermée tant qu'aucun partenaire n'est branché.
PARTNER_WEBHOOKS_ENABLED=0
