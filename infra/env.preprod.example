# Copier en infra/.env.preprod SUR LE SERVEUR (jamais versionné, cf. .gitignore).
#
# ⚠ DEUX FORMATS, ET LES CONFONDRE FAIT REFUSER LE DÉMARRAGE.
#
#   mots de passe, APP_SECRET, passphrases :  openssl rand -hex 32
#   clés de chiffrement et de scellement    :  openssl rand -base64 32
#
# Les secondes sont lues par `base64_decode()` et doivent faire exactement 32 octets une fois
# décodées. `DocumentStreamCipher` refuse de démarrer sinon (RG-DMS-25) — c'est le bon
# comportement, mais il ne s'exerce que si la valeur est vraiment absente ou fausse.

APP_SECRET=

DB_NAME=billetterie_preprod
DB_USER=billetterie
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_PASSPHRASE=

# ── CLÉS DE CHIFFREMENT ET DE SCELLEMENT ────────────────────────────────────────────────────────
#
# ⚠ UNE CLÉ PAR INSTALLATION (décision de Maxime relayée par `b8`, 31/08).
#
# Elles vivaient dans `app/.env`, qui est VERSIONNÉ : toute installation suivant la procédure
# héritait des clés du dépôt. Un chiffrement au repos ne protège alors de rien contre quiconque a
# accès au dépôt, et toutes les installations partagent le même secret.
#
# ⚠ CELLES-CI SE GÉNÈRENT UNE FOIS ET NE SE REGÉNÈRENT JAMAIS. Les changer rend indéchiffrable ce
# qui a été chiffré avant, et invérifiables les signatures déjà posées — exactement comme regénérer
# les clés JWT invaliderait tous les jetons émis.
#
#   openssl rand -base64 32

# Documents de la GED, chiffrés au repos.
DMS_ENCRYPTION_KEY=

# Second facteur d'authentification.
MFA_ENCRYPTION_KEY=

# Coordonnées bancaires (mandats SEPA).
SEPA_IBAN_KEY=

# Clés d'API tierces confiées par le client (OCR).
OCR_API_KEY_ENCRYPTION_KEY=

# Jetons des comptes de réseaux sociaux.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# URL de webhook des connecteurs (Slack, Teams, Discord). Une URL de webhook est un droit de
# publier dans un canal, sans autre authentification : elle se chiffre au repos.
INTEGRATIONS_WEBHOOK_KEY=

# ── SCELLEMENT NF525 ────────────────────────────────────────────────────────────────────────────
#
# Une clé DÉDIÉE par chaîne : compromettre l'une ne doit pas donner les autres.
#
# ⚠ L'empreinte de la chaîne ne dépend d'aucune clé — `hash(payload + empreinte précédente)`. C'est
# la SIGNATURE qui en dépend : `hash_hmac(empreinte, clé)`. Changer une clé laisse donc la chaîne
# vérifiable et rend les signatures antérieures invérifiables.
NF525_SEAL_KEY=
NF525_COMPTA_SEAL_KEY=
NF525_FACTURATION_SEAL_KEY=
