# Application (Symfony)
/app/vendor/
/app/var/
# Exports d import (TEDB, referentiels tiers) : volumineux, dates, jamais versionnes.
# ⚠ PAS `app/var/` : un volume Docker (`app_var:/app/var`) le RECOUVRE dans le conteneur,
#   donc un fichier depose la depuis l hote y est invisible.
/app/imports/
/app/.env.local
/app/.env.*.local
/app/public/bundles/
/app/config/secrets/*/*.php

# Docker / DB
/docker/data/

# Infra : secrets serveur (jamais versionnés)
/infra/.env.*
!/infra/env.*.example

# OS / IDE
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.log

# Node (outillage build artefacts éventuel)
node_modules/
